# Exemple de configuration — copie ce fichier en `.env` et remplis les valeurs (le fichier `.env` n'est jamais versionné).
# En production, ces valeurs se saisissent dans l'interface de l'hébergeur (voir DEPLOY.md), pas dans un fichier.

# ─── Base de données PostgreSQL ────────────────────────────────────────────────────────────────────────────────
# En local : lance `npm run db:dev` (base PostgreSQL embarquée, rien à installer) et utilise ces deux lignes.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=1&pgbouncer=true"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable&connection_limit=1"
# En production : DATABASE_URL = l'adresse de la base (celle « poolée » si l'hébergeur en propose une),
# DIRECT_URL = l'adresse directe (utilisée seulement pour appliquer les migrations).

# ─── Connexion (obligatoire) ───────────────────────────────────────────────────────────────────────────────────
# Une longue valeur aléatoire qui signe les sessions. Génère-la avec : openssl rand -base64 32
AUTH_SECRET=""
# L'adresse publique de l'appli (utilisée dans les emails « mot de passe oublié »). Ex : https://app.myresto.be
APP_URL="http://localhost:3000"
# Derrière l'hébergeur : à mettre à true pour que la connexion fasse confiance à l'adresse transmise.
# AUTH_TRUST_HOST="true"

# ─── Création de compte ────────────────────────────────────────────────────────────────────────────────────────
# En production, la création d'un établissement n'est possible qu'avec ce code (que TU donnes à tes testeurs).
# Sans code configuré en production, les inscriptions sont fermées.
# SIGNUP_INVITE_CODE="choisis-un-code-secret"

# ─── Envoi d'emails (mot de passe oublié, formulaire de contact) ───────────────────────────────────────────────
# Sans ces lignes : le message de contact est quand même enregistré, mais « mot de passe oublié » n'envoie rien.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="adresse-qui-envoie@gmail.com"
# Pour Gmail : un « mot de passe d'application » (compte Google → Sécurité), jamais le mot de passe du compte.
SMTP_PASS=""
# Facultatif : l'adresse affichée comme expéditeur (par défaut SMTP_USER).
# SMTP_FROM="MYRESTO <adresse-qui-envoie@gmail.com>"
# Facultatif : l'adresse qui REÇOIT les messages du formulaire de contact (par défaut chloehamoir@gmail.com).
# SUPPORT_EMAIL="chloehamoir@gmail.com"

# ─── Réglages facultatifs ──────────────────────────────────────────────────────────────────────────────────────
# Fuseau horaire de l'appli (par défaut Europe/Brussels) : les serveurs tournent en UTC, on le corrige au démarrage.
# APP_TIMEZONE="Europe/Brussels"
# Adresses autorisées à envoyer des formulaires, si l'appli est derrière un intermédiaire (séparées par des virgules).
# SERVER_ACTION_ORIGINS="app.myresto.be"
